/aaa BUILD Apple/*
/aaa APK/*
/aaa Apple/*

# Poznámky
aaaPoznamky.txt

# Blender backup
*.blend1
*.blend1.meta

# GitIgnore
*.ignore
*.ignore.*
*.gignore
*.gignore.*

# AI Gemini CLI
